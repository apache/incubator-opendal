#[cfg(test)]
mod tests {
    use std::ffi::{CStr, CString};
    use std::ptr;

    use opendal::raw::Timestamp;

    use super::*;

    fn message(error: &OpenDALError) -> String {
        unsafe { CStr::from_ptr(error.message) }
            .to_string_lossy()
            .into_owned()
    }

    #[test]
    fn read_options_defaults_on_null() {
        let options = read_options::<OpendalReadOptions>(ptr::null()).unwrap();
        assert_eq!(options, opendal::options::ReadOptions::default());
    }

    #[test]
    fn read_options_matches_core_defaults() {
        // C# sends a count of 1 where core defaults to 0; core reads both as
        // no concurrency.
        let options = read_options(&OpendalReadOptions::default()).unwrap();
        assert_eq!(
            options,
            opendal::options::ReadOptions {
                concurrent: 1,
                ..Default::default()
            }
        );
    }

    #[test]
    fn read_options_copies_borrowed_values() {
        let etag = CString::new("\"e\"").unwrap();
        let native = OpendalReadOptions {
            offset: 4,
            length_has_value: 1,
            length: 6,
            if_match: etag.as_ptr(),
            if_modified_since_has_value: 1,
            if_modified_since_second: 1_700_000_000,
            if_modified_since_nanosecond: 123,
            chunk_has_value: 1,
            chunk: 1024,
            ..Default::default()
        };
        let options = read_options(&native).unwrap();
        drop(etag);

        assert_eq!(options.range, BytesRange::from(4..10));
        assert_eq!(options.if_match.as_deref(), Some("\"e\""));
        assert_eq!(
            options.if_modified_since,
            Some(Timestamp::new(1_700_000_000, 123).unwrap())
        );
        assert_eq!(options.chunk, Some(1024));
    }

    #[test]
    fn read_options_rejects_suffix_with_offset() {
        let native = OpendalReadOptions {
            offset: 1,
            suffix_length_has_value: 1,
            suffix_length: 1,
            ..Default::default()
        };
        let err = read_options(&native).expect_err("a suffix range cannot have an offset");
        assert!(message(&err).contains("suffix_length"));
    }

    #[test]
    fn read_options_rejects_zero_concurrent() {
        let native = OpendalReadOptions {
            concurrent: 0,
            ..Default::default()
        };
        let err = read_options(&native).expect_err("concurrent must be positive");
        assert!(message(&err).contains("read concurrent"));
    }

    #[test]
    fn read_options_names_invalid_utf8() {
        let invalid = [0xffu8, 0];
        let native = OpendalReadOptions {
            version: invalid.as_ptr().cast(),
            ..Default::default()
        };
        let err = read_options(&native).expect_err("invalid UTF-8 must fail");
        assert!(message(&err).contains("version"));
    }

    #[test]
    fn write_options_rebuild_user_metadata_and_metadata() {
        let key = CString::new("k").unwrap();
        let value = CString::new("v").unwrap();
        let keys = [key.as_ptr()];
        let values = [value.as_ptr()];
        let etag = CString::new("e").unwrap();

        // Metadata without values has only null strings, so replacing one
        // with a borrowed pointer neither overwrites nor leaks owned memory.
        let mut metadata =
            OpendalMetadata::from_metadata(opendal::MetadataBuilder::file(0).build());
        metadata.content_length = 5;
        metadata.etag = etag.as_ptr().cast_mut();

        let native = OpendalWriteOptions {
            user_metadata_has_value: 1,
            user_metadata_keys: keys.as_ptr(),
            user_metadata_values: values.as_ptr(),
            user_metadata_len: 1,
            if_not_changed: &metadata,
            ..Default::default()
        };
        let options = read_options(&native).unwrap();

        assert_eq!(options.user_metadata.unwrap()["k"], "v");
        let rebuilt = options.if_not_changed.unwrap();
        assert!(rebuilt.is_file());
        assert_eq!(rebuilt.content_length(), 5);
        assert_eq!(rebuilt.etag(), Some("e"));
    }

    #[test]
    fn write_options_keep_empty_user_metadata() {
        let native = OpendalWriteOptions {
            user_metadata_has_value: 1,
            ..Default::default()
        };
        let options = read_options(&native).unwrap();
        assert_eq!(options.user_metadata, Some(Default::default()));
    }

    #[test]
    fn write_options_name_null_user_metadata_value() {
        let key = CString::new("k").unwrap();
        let keys = [key.as_ptr()];
        let values = [ptr::null::<c_char>()];
        let native = OpendalWriteOptions {
            user_metadata_has_value: 1,
            user_metadata_keys: keys.as_ptr(),
            user_metadata_values: values.as_ptr(),
            user_metadata_len: 1,
            ..Default::default()
        };
        let err = read_options(&native).expect_err("a null value must fail");
        assert!(message(&err).contains("value of user_metadata k is null"));
    }
